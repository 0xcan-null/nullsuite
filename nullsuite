import argparse
import sys
import time
import json
from recon import run_recon
from scanner import run_scanner
from fuzzer import run_fuzzer

BANNER = r"""
  _  _ _  _ _    _    ___ _   _ ___ _____ ___ 
 | \| | | | | |  | |  / __| | | |_ _|_   _| __|
 | .` | |_| | |__| |__\__ \ |_| || |  | | | _| 
 |_|\_|\___/|____|____|___/\___/|___| |_| |___|
          All-in-One Recon Automation Framework
"""

def print_colored(text, color="white"):
    colors = {
        "red": "\033[91m", "green": "\033[92m",
        "yellow": "\033[93m", "blue": "\033[94m",
        "cyan": "\033[96m", "white": "\033[97m",
        "reset": "\033[0m"
    }
    print(f"{colors.get(color, colors['white'])}{text}{colors['reset']}")

def main():
    print_colored(BANNER, "cyan")
    
    parser = argparse.ArgumentParser(description="nullsuite - Automated Recon & Attack Surface Mapping Tool")
    parser.add_argument("-d", "--domain", required=True, help="Hedef Domain (Orn: example.com)")
    parser.add_argument("-o", "--output", help="Sonuclari JSON olarak kaydet (Orn: rapor.json)")
    args = parser.parse_args()

    target_domain = args.domain.replace("https://", "").replace("http://", "").split("/")[0]
    
    print_colored(f"[*] Hedef Tanimlandi: {target_domain}", "yellow")
    print_colored("[*] Surec Baslatiliyor...\n", "yellow")
    
    report = {
        "target": target_domain,
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "subdomains": []
    }

    # 1. ASAMA: Subdomain Kesfi
    print_colored("[+] ASAMA 1: Subdomain ve DNS Kesfi Baslatildi...", "blue")
    subdomains = run_recon(target_domain)
    print_colored(f"[>] {len(subdomains)} adet aktif subdomain bulundu.\n", "green")

    # Eger hic subdomain bulunamazsa ana domaini ekle
    if not subdomains:
        subdomains = [{"subdomain": target_domain, "ip": target_domain}]

    # 2. ASAMA: Port Tarama & Fuzzing
    for sub in subdomains:
        sub_name = sub["subdomain"]
        sub_ip = sub["ip"]
        
        print_colored(f"[*] Hedef Analiz Ediliyor: {sub_name} ({sub_ip})", "cyan")
        
        # Port Taramasi
        open_ports = run_scanner(sub_ip)
        print(f"    └── [Portlar]: {open_ports if open_ports else 'Acik port bulunamadi'}")
        
        # Web Dizin Fuzzing (80 veya 443 aciksa)
        discovered_paths = []
        if 80 in open_ports or 443 in open_ports or open_ports:
            print_colored(f"    └── Web Servisi Tespit Edildi, Fuzzing Baslatiliyor...", "yellow")
            discovered_paths = run_fuzzer(sub_name)
            for path in discovered_paths:
                print(f"        ├── [{path['status']}] {path['path']}")

        report["subdomains"].append({
            "subdomain": sub_name,
            "ip": sub_ip,
            "open_ports": open_ports,
            "paths": discovered_paths
        })
        print("-" * 50)

    # 3. ASAMA: Raporlama
    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            json.dump(report, f, indent=4)
        print_colored(f"\n[+] Rapor Basariyla Kaydedildi: {args.output}", "green")

    print_colored("\n[✔] nullsuite Gorevini Tamamladi! Sistem Temiz.", "green")

if __name__ == "__main__":
    main()
    
